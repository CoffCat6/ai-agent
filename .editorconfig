# Editor defaults for the repository.
#
# C++ formatting rules live in .clang-format (that file is authoritative for
# layout); this file only pins the basics an editor needs before it knows the
# language: encoding, line endings, indentation and trailing whitespace.
#
# Line endings match .gitattributes (`* text=auto eol=lf`).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Markdown uses two trailing spaces as a hard line break.
[*.md]
trim_trailing_whitespace = false

# Qt .ts translation catalogues are lupdate-generated XML.
[*.{ts,ui,qrc}]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2
