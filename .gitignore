/.cache
/build
# Parallel-lane build dirs (build-<lane>), used so concurrent agents do not
# race each other's ninja in a shared tree. Same rationale as /build.
/build-*
/.agents
/.*
/txt
/deploy
NexusAI-*-win64.zip
# lupdate leaves *.ts.bak snapshots next to the .ts it rewrites. The .ts is the
# single source of truth; the backup must never land in the repo.
translations/*.ts.bak
# lrelease output. The build regenerates these into the build tree and embeds
# them into the executable's :/i18n resource, so the copies under translations/
# are dead artifacts that silently drift from the .ts.
translations/*.qm
!/github
!.gitattributes
# Root dotfiles are ignored wholesale above; these are repository config.
!.clang-format
!.editorconfig
!.gitignore
